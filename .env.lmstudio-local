###############################################################################
# Cognee local-runtime configuration
# Targets LM Studio on the host (http://jims-mac-studio.local:1234) for LLM
# and Ollama on the host (http://host.docker.internal:11434) for embeddings.
#
# Use this file when running Cognee inside a container/devcontainer and your
# LLM/embedding servers are on the macOS host. On Docker Desktop for Mac,
# host.docker.internal resolves to the host; jims-mac-studio.local is the
# Bonjour hostname of the machine running LM Studio.
#
# Copy to .env before starting:
#   cp .env.lmstudio-local .env
###############################################################################

###############################################################################
# LLM — LM Studio (OpenAI-compatible local server)
###############################################################################
LLM_API_KEY="lm-studio"
LLM_PROVIDER="custom"
LLM_MODEL="qwen/qwen3-coder-next"
LLM_ENDPOINT="http://jims-mac-studio.local:1234/v1"

# LM Studio / local models usually need explicit structured-output mode.
# "json_schema_mode" works when the model supports response_format=json_schema;
# fall back to "json_mode" or "md_json" if you see validation errors.
LLM_INSTRUCTOR_MODE="json_schema_mode"

# Conservative token limit for a local Qwen coder model. Raise if your loaded
# model supports a larger context window.
LLM_MAX_TOKENS="32768"

###############################################################################
# Embeddings — Ollama on the host
###############################################################################
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_ENDPOINT="http://host.docker.internal:11434/api/embed"
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_TOKENS=8191
EMBEDDING_BATCH_SIZE=36
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"

###############################################################################
# Databases — file-based defaults (no extra services needed)
###############################################################################
DB_PROVIDER="sqlite"
DB_NAME=cognee_db

GRAPH_DATABASE_PROVIDER="kuzu"
GRAPH_DATASET_DATABASE_HANDLER="kuzu"

VECTOR_DB_PROVIDER="lancedb"
VECTOR_DATASET_DATABASE_HANDLER="lancedb"

###############################################################################
# Storage / paths
###############################################################################
STORAGE_BACKEND="local"
# Persist Cognee data inside the workspace so it survives container rebuilds.
DATA_ROOT_DIRECTORY="/workspaces/cognee/.cognee_data"
SYSTEM_ROOT_DIRECTORY="/workspaces/cognee/.cognee_system"

###############################################################################
# Security — local single-user mode
###############################################################################
REQUIRE_AUTHENTICATION=False
ENABLE_BACKEND_ACCESS_CONTROL=False

ACCEPT_LOCAL_FILE_PATH=True
ALLOW_HTTP_REQUESTS=True
ALLOW_CYPHER_QUERY=True

###############################################################################
# Runtime
###############################################################################
ENV="local"
ENVIRONMENT="local"
HOST="0.0.0.0"
HTTP_PORT=8000
HTTP_API_HOST="0.0.0.0"
HTTP_API_PORT=8000

LITELLM_LOG="ERROR"
TOKENIZERS_PARALLELISM="false"

###############################################################################
# UI
###############################################################################
UI_APP_URL=http://localhost:3000

###############################################################################
# Structured output framework
###############################################################################
STRUCTURED_OUTPUT_FRAMEWORK="instructor"
